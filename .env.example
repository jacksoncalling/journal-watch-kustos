# journal-watch secrets. This is the ONLY .env the scripts read.
# Replace each placeholder value (everything after the =) with your real key.
# No quotes. Save the file (Ctrl+S) after editing.
#
# ANTHROPIC: real key starts with  sk-ant-   (synthesis fallback)
# GEMINI:    real key starts with  AIza      (synthesis primary; aistudio.google.com)
# TELEGRAM:  bot token from @BotFather; chat id via `send_telegram.py --whoami`

ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
GEMINI_API_KEY=AIza_REPLACE_ME
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
